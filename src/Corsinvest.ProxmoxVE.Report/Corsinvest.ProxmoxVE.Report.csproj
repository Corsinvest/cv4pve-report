<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <OutputType>Library</OutputType>
        <Product>Corsinvest for Proxmox VE Report Api</Product>
        <AssemblyTitle>Corsinvest for Proxmox VE Report Api</AssemblyTitle>
        <Description>Report API library for Proxmox VE: exports the infrastructure inventory to Excel, HTML or JSON</Description>
        <PackageTags>ProxmoxVE;Api;Client;Rest;Corsinvest;Report;Excel</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Local test feed: every build drops the package in ProxmoxVE\.nupkgs -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>..\..\..\.nupkgs\</PackageOutputPath>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <!-- Symbols: PDB inside the .nupkg (local debugging) and .snupkg for nuget.org -->
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="" />
        <None Include="..\..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Corsinvest.ProxmoxVE.Report.Tests" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Corsinvest.ProxmoxVE.Api.Extension" />
        <PackageReference Include="ClosedXML" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Writers\Html\Assets\style.css" />
        <EmbeddedResource Include="Writers\Html\Assets\app.js" />
        <EmbeddedResource Include="Writers\Html\Assets\table.js" />
    </ItemGroup>
</Project>